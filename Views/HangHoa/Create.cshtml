@model TranVanKiet_2023.Models.HangHoa
@{
    ViewData["Title"] = "Thêm Hàng Hóa Mới";
}

<div class="content_top">
    <div class="heading">
        <h3>Trần Văn Kiệt</h3>
        <p>Thêm Hàng Hóa Mới</p>
    </div>
    <div class="clear"></div>
</div>

<div style="margin-top: 20px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color: #CD1F25; margin-bottom: 10px;"></div>

        <div style="margin-bottom: 12px;">
            <label asp-for="MaLoai" style="display:block; font-weight:bold;">MaLoai</label>
            <select asp-for="MaLoai" asp-items="ViewBag.MaLoai" style="padding:6px; min-width:200px;"></select>
            <span asp-validation-for="MaLoai" style="color: #CD1F25; display:block;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="TenHang" style="display:block; font-weight:bold;">TenHang</label>
            <input asp-for="TenHang" type="text" style="padding:6px; width:300px;" />
            <span asp-validation-for="TenHang" style="color: #CD1F25; display:block;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="Gia" style="display:block; font-weight:bold;">Gia</label>
            <input asp-for="Gia" type="text" style="padding:6px; width:300px;" />
            <span asp-validation-for="Gia" style="color: #CD1F25; display:block;"></span>
        </div>

        <div style="margin-bottom: 12px;">
            <label asp-for="Anh" style="display:block; font-weight:bold;">Anh</label>
            <input asp-for="Anh" type="text" placeholder="vd: Img_1.jpg" style="padding:6px; width:300px;" />
            <span asp-validation-for="Anh" style="color: #CD1F25; display:block;"></span>
        </div>

        <button type="submit" style="padding: 8px 18px; cursor: pointer;">Create</button>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}